---
import type { GetStaticPathsOptions } from "astro";
import PageLayout from "@/layouts/PageLayout.astro";
import {
  getPublishedPosts,
  getAllTags,
  readingTime,
  formatDate,
  postSlug,
} from "@/lib/blog";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<PageLayout title="Blog" description="Essays, notes, and working logs.">
  <section class="blog container">
    <header class="blog__header">
      <p class="blog__eyebrow">Writing</p>
      <h1 class="blog__title">Blog</h1>
      <p class="blog__desc">
        Tech notes, daily thoughts, reading notes, and more.
      </p>
    </header>

    {tags.length > 0 && (
      <nav class="tags" aria-label="Filter by tag">
        {tags.map(({ tag, count }) => (
          <a class="tags__item" href={`/blog/tag/${tag}`}>
            {tag} <span class="tags__count">{count}</span>
          </a>
        ))}
        <a class="tags__item tags__item--subtle" href="/blog/archives">
          Archives
        </a>
      </nav>
    )}

    <ul class="post-list">
      {page.data.map((post) => {
        const slug = postSlug(post);
        const body = (post as any).body ?? "";
        return (
          <li class="post-item">
            <a class="post-item__link" href={`/blog/${slug}`}>
              <div class="post-item__content">
                <h2 class="post-item__title">{post.data.title}</h2>
                {post.data.description && (
                  <p class="post-item__desc">{post.data.description}</p>
                )}
                <div class="post-item__meta">
                  <time datetime={post.data.date.toISOString()}>
                    {formatDate(post.data.date)}
                  </time>
                  <span class="post-item__dot" aria-hidden="true" />
                  <span>{readingTime(body)}</span>
                  {post.data.tags.length > 0 && (
                    <>
                      <span class="post-item__dot" aria-hidden="true" />
                      <span class="post-item__tags">
                        {post.data.tags.slice(0, 3).join(" · ")}
                      </span>
                    </>
                  )}
                </div>
              </div>
              <span class="post-item__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        );
      })}
    </ul>

    {page.lastPage > 1 && (
      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? (
          <a class="pager__link" href={page.url.prev}>← Prev</a>
        ) : (
          <span class="pager__link pager__link--disabled">← Prev</span>
        )}
        <span class="pager__info">
          {page.currentPage} / {page.lastPage}
        </span>
        {page.url.next ? (
          <a class="pager__link" href={page.url.next}>Next →</a>
        ) : (
          <span class="pager__link pager__link--disabled">Next →</span>
        )}
      </nav>
    )}

    {page.data.length === 0 && (
      <div class="empty">
        <p>No posts yet — writing in progress.</p>
      </div>
    )}
  </section>
</PageLayout>

<style>
  .blog {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .blog__header {
    margin-bottom: var(--space-8);
  }

  .blog__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .blog__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .blog__desc {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-lg);
  }

  /* ─── Tags ─── */

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-rule);
  }

  .tags__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-full);
    color: var(--color-ink-secondary);
    font-size: var(--text-xs);
    letter-spacing: 0.03em;
    transition:
      color var(--duration-fast) var(--ease-smooth),
      border-color var(--duration-fast) var(--ease-smooth),
      background-color var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-smooth);
  }

  .tags__item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .tags__item--subtle {
    border-style: dashed;
    color: var(--color-ink-tertiary);
  }

  .tags__count {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    opacity: 0.7;
  }

  /* ─── Post List ─── */

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    border-bottom: 1px solid var(--color-rule);
  }

  .post-item__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) 0;
    transition: padding-left var(--duration-fast) var(--ease-smooth);
  }

  .post-item__link:hover {
    padding-left: var(--space-2);
  }

  .post-item__content {
    flex: 1;
    min-width: 0;
  }

  .post-item__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .post-item__link:hover .post-item__title {
    color: var(--color-accent);
  }

  .post-item__desc {
    margin: var(--space-2) 0 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-item__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.02em;
  }

  .post-item__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-ink-tertiary);
    opacity: 0.5;
  }

  .post-item__tags {
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .post-item__arrow {
    flex-shrink: 0;
    font-size: var(--text-lg);
    color: var(--color-ink-tertiary);
    opacity: 0;
    transform: translateX(-8px);
    transition:
      color var(--duration-fast) var(--ease-smooth),
      opacity var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-smooth);
  }

  .post-item__link:hover .post-item__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ─── Pagination ─── */

  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .pager__link {
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.04em;
    transition: opacity var(--duration-fast) var(--ease-smooth);
  }

  .pager__link:hover {
    opacity: 0.7;
  }

  .pager__link--disabled {
    color: var(--color-ink-tertiary);
    opacity: 0.4;
    pointer-events: none;
  }

  .pager__info {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.06em;
  }

  /* ─── Empty ─── */

  .empty {
    padding: var(--space-16) var(--space-8);
    text-align: center;
    color: var(--color-ink-tertiary);
    border: 1px dashed var(--color-rule);
    border-radius: var(--radius-lg);
  }

  /* ─── Crimson Nocturne ─── */

  :global(html[data-skin="nocturne"]) .blog__header {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    min-height: 420px;
    padding: clamp(36px, 7vw, 82px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent) 48%, transparent);
    background-image:
      linear-gradient(90deg, rgba(8, 9, 21, 0.98) 0%, rgba(8, 9, 21, 0.9) 43%, rgba(8, 9, 21, 0.18) 76%),
      url("/images/themes/crimson-nocturne/blog-hero.webp");
    background-position: center;
    background-size: cover;
    box-shadow: var(--shadow-lg);
    clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 30px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
  }

  :global(html[data-skin="nocturne"]) .blog__header::before {
    content: "INK / EMBER / LOG";
    position: absolute;
    right: clamp(16px, 3vw, 34px);
    bottom: clamp(14px, 2vw, 24px);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    color: rgba(242, 238, 223, 0.55);
  }

  :global(html[data-skin="nocturne"]) .blog__header::after {
    content: "";
    position: absolute;
    left: 0;
    top: 18%;
    bottom: 18%;
    width: 4px;
    background: linear-gradient(transparent, var(--color-accent), transparent);
    box-shadow: 8px 0 24px rgba(255, 55, 111, 0.4);
  }

  :global(html[data-skin="nocturne"]) .blog__eyebrow,
  :global(html[data-skin="nocturne"]) .blog__title,
  :global(html[data-skin="nocturne"]) .blog__desc {
    position: relative;
    z-index: 1;
    max-width: 52%;
  }

  :global(html[data-skin="nocturne"]) .blog__eyebrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  :global(html[data-skin="nocturne"]) .blog__title {
    font-size: clamp(3.4rem, 8vw, 6.5rem);
    font-weight: 900;
    letter-spacing: -0.075em;
    line-height: 0.9;
    text-transform: uppercase;
    text-shadow: 5px 5px 0 var(--color-nocturne-wine);
    transform: skewX(-3deg);
  }

  :global(html[data-skin="nocturne"]) .blog__desc {
    max-width: 34ch;
    font-size: var(--text-base);
  }

  :global(html[data-skin="nocturne"]) .tags {
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid color-mix(in srgb, var(--color-accent) 22%, var(--color-rule));
    background: rgba(15, 17, 34, 0.78);
    box-shadow: 4px 4px 0 rgba(88, 21, 47, 0.28);
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
  }

  :global(html[data-skin="nocturne"]) .tags__item {
    font-family: var(--font-mono);
    border-color: color-mix(in srgb, var(--color-accent) 24%, var(--color-rule));
    clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%);
  }

  :global(html[data-skin="nocturne"]) .tags__item:hover {
    color: var(--color-ink);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
    transform: translateY(-2px) rotate(-0.5deg);
  }

  :global(html[data-skin="nocturne"]) .post-list {
    position: relative;
    padding-left: var(--space-4);
  }

  :global(html[data-skin="nocturne"]) .post-list::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--color-accent), rgba(255, 55, 111, 0.08));
  }

  :global(html[data-skin="nocturne"]) .post-item {
    border-bottom-color: color-mix(in srgb, var(--color-accent) 15%, var(--color-rule));
  }

  :global(html[data-skin="nocturne"]) .post-item__link {
    position: relative;
    padding-right: var(--space-4);
    border-left: 0 solid transparent;
    background: linear-gradient(90deg, transparent, transparent);
    transition:
      padding-left var(--duration-fast) var(--ease-smooth),
      background-color var(--duration-fast) var(--ease-smooth);
  }

  :global(html[data-skin="nocturne"]) .post-item__link::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--space-4) - 3px);
    top: 50%;
    width: 8px;
    height: 8px;
    border: 2px solid var(--color-accent);
    background: var(--color-bg);
    transform: translateY(-50%) rotate(45deg);
  }

  :global(html[data-skin="nocturne"]) .post-item__link:hover {
    padding-left: var(--space-4);
    background: linear-gradient(90deg, rgba(255, 55, 111, 0.08), transparent 72%);
  }

  :global(html[data-skin="nocturne"]) .post-item__title {
    font-family: var(--font-body);
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  :global(html[data-skin="nocturne"]) .post-item__arrow {
    color: var(--color-accent);
    text-shadow: 0 0 10px rgba(255, 55, 111, 0.45);
  }

  :global(html[data-skin="nocturne"]) .pager {
    border-top-color: color-mix(in srgb, var(--color-accent) 25%, var(--color-rule));
  }

  /* ─── Responsive ─── */

  @media (max-width: 640px) {
    .blog {
      padding-top: var(--space-12);
    }

    .post-item__desc {
      display: none;
    }

    .post-item__arrow {
      display: none;
    }

    :global(html[data-skin="nocturne"]) .blog__header {
      min-height: 350px;
      padding: var(--space-8) var(--space-6);
      background-image:
        linear-gradient(90deg, rgba(8, 9, 21, 0.98) 0%, rgba(8, 9, 21, 0.88) 56%, rgba(8, 9, 21, 0.36) 100%),
        url("/images/themes/crimson-nocturne/blog-hero.webp");
      background-position: 60% center;
    }

    :global(html[data-skin="nocturne"]) .blog__eyebrow,
    :global(html[data-skin="nocturne"]) .blog__title,
    :global(html[data-skin="nocturne"]) .blog__desc {
      max-width: 78%;
    }

    :global(html[data-skin="nocturne"]) .blog__title {
      font-size: clamp(2.8rem, 15vw, 4.25rem);
    }

    :global(html[data-skin="nocturne"]) .blog__desc {
      font-size: var(--text-sm);
    }

    :global(html[data-skin="nocturne"]) .tags {
      clip-path: none;
    }
  }
</style>
