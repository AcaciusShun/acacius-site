---
import { getCollection, render } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import { readingTime, formatDate, postSlug } from "@/lib/blog";
import TwikooComments from "@/components/interactive/TwikooComments.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      prev: posts[i + 1] || null,
      next: posts[i - 1] || null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const body = (post as any).body ?? "";
const tocHeadings = headings.filter((h) => h.depth <= 3);
---

<PageLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.cover?.image}
  publishedTime={post.data.date.toISOString()}
  tags={post.data.tags}
>
  <div class="progress-bar" id="progress-bar"></div>

  <article class="article container">
    <header class="article__header">
      <div class="article__meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span class="article__dot" aria-hidden="true" />
        <span>{readingTime(body)}</span>
      </div>
      <h1 class="article__title">{post.data.title}</h1>
      {post.data.description && (
        <p class="article__lead">{post.data.description}</p>
      )}
      {post.data.tags.length > 0 && (
        <div class="article__tags">
          {post.data.tags.map((tag) => (
            <span class="article__tag">{tag}</span>
          ))}
        </div>
      )}
      {post.data.cover && (
        <figure class="article__cover">
          <img src={post.data.cover.image} alt={post.data.cover.alt} />
        </figure>
      )}
    </header>

    <div class="article__body">
      {tocHeadings.length >= 3 && (
        <aside class="toc" id="toc">
          <p class="toc__label">Contents</p>
          <nav>
            <ul class="toc__list">
              {tocHeadings.map((h) => (
                <li class:list={["toc__item", `toc__item--${h.depth}`]}>
                  <a class="toc__link" href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="article__footer">
      <div class="article__footer-rule" aria-hidden="true" />
      {post.data.lastmod && (
        <p class="article__updated">
          Last updated: {formatDate(post.data.lastmod)}
        </p>
      )}
      <a class="article__back" href="/blog">← Back to all posts</a>
    </footer>

    {(prev || next) && (
      <nav class="post-nav" aria-label="Post navigation">
        {prev ? (
          <a class="post-nav__link post-nav__link--prev" href={`/blog/${postSlug(prev)}`}>
            <span class="post-nav__label">← Older</span>
            <span class="post-nav__title">{prev.data.title}</span>
          </a>
        ) : <div />}
        {next ? (
          <a class="post-nav__link post-nav__link--next" href={`/blog/${postSlug(next)}`}>
            <span class="post-nav__label">Newer →</span>
            <span class="post-nav__title">{next.data.title}</span>
          </a>
        ) : <div />}
      </nav>
    )}

    <TwikooComments path={`/blog/${postSlug(post)}`} />
  </article>
</PageLayout>

<script is:inline>
  (function () {
    var bar = document.getElementById("progress-bar");
    if (!bar) return;
    var ticking = false;
    window.addEventListener("scroll", function () {
      if (!ticking) {
        requestAnimationFrame(function () {
          var h = document.documentElement.scrollHeight - window.innerHeight;
          var pct = h > 0 ? (window.scrollY / h) * 100 : 0;
          bar.style.width = pct + "%";
          ticking = false;
        });
        ticking = true;
      }
    });
  })();
</script>

<script is:inline>
(function () {
  // Code block copy button
  document.querySelectorAll(".prose pre").forEach(function (pre) {
    var btn = document.createElement("button");
    btn.className = "code-copy";
    btn.textContent = "Copy";
    btn.setAttribute("aria-label", "Copy code");
    pre.style.position = "relative";
    pre.appendChild(btn);
    btn.addEventListener("click", function () {
      var code = pre.querySelector("code");
      var text = code ? code.textContent : pre.textContent;
      navigator.clipboard.writeText(text || "").then(function () {
        btn.textContent = "Copied!";
        setTimeout(function () { btn.textContent = "Copy"; }, 1500);
      });
    });
  });

  // Image lightbox
  var overlay = document.createElement("div");
  overlay.className = "lightbox";
  overlay.innerHTML = '<img class="lightbox__img" />';
  document.body.appendChild(overlay);
  var lbImg = overlay.querySelector(".lightbox__img");

  document.querySelectorAll(".prose img").forEach(function (img) {
    img.style.cursor = "zoom-in";
    img.addEventListener("click", function () {
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      overlay.classList.add("lightbox--open");
      document.body.style.overflow = "hidden";
    });
  });

  overlay.addEventListener("click", function () {
    overlay.classList.remove("lightbox--open");
    document.body.style.overflow = "";
  });

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape" && overlay.classList.contains("lightbox--open")) {
      overlay.classList.remove("lightbox--open");
      document.body.style.overflow = "";
    }
  });
})();
</script>

<style>
  /* ─── Code Copy Button ─── */

  .code-copy {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    padding: 2px var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-ink-tertiary);
    background: var(--color-bg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-smooth),
                color var(--duration-fast) var(--ease-smooth);
  }

  :global(.prose pre:hover) .code-copy {
    opacity: 1;
  }

  .code-copy:hover {
    color: var(--color-accent);
  }

  /* ─── Lightbox ─── */

  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    opacity: 0;
    pointer-events: none;
    cursor: zoom-out;
    transition: opacity var(--duration-normal) var(--ease-smooth);
  }

  :global(.lightbox--open) {
    opacity: 1;
    pointer-events: auto;
  }

  :global(.lightbox__img) {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: var(--radius-md);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
    transform: scale(0.95);
    transition: transform var(--duration-normal) var(--ease-smooth);
  }

  :global(.lightbox--open .lightbox__img) {
    transform: scale(1);
  }

  /* ─── Progress Bar ─── */

  .progress-bar {
    position: fixed;
    top: 64px;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--color-accent);
    z-index: 40;
    transition: width 60ms linear;
  }

  /* ─── Article ─── */

  .article {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .article__header {
    max-width: var(--prose-max);
    margin-bottom: var(--space-12);
  }

  .article__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .article__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-ink-tertiary);
    opacity: 0.5;
  }

  .article__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .article__lead {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-ink-secondary);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .article__tag {
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-ink-tertiary);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
  }

  /* ─── Cover ─── */

  .article__cover {
    max-width: var(--prose-max);
    margin: var(--space-8) 0 0;
  }

  .article__cover img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-rule);
  }

  /* ─── Body with TOC ─── */

  .article__body {
    position: relative;
  }

  .toc {
    position: fixed;
    top: 96px;
    right: max(calc((100vw - var(--layout-max)) / 2), 24px);
    width: 200px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    font-size: var(--text-xs);
  }

  .toc__label {
    margin: 0 0 var(--space-2);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    line-height: 1.4;
  }

  .toc__item--2 { padding-left: 0; }
  .toc__item--3 { padding-left: var(--space-3); }

  .toc__link {
    display: block;
    padding: 3px 0;
    color: var(--color-ink-tertiary);
    transition: color var(--duration-fast) var(--ease-smooth);
    border-left: 2px solid transparent;
    padding-left: var(--space-2);
  }

  .toc__link:hover {
    color: var(--color-accent);
  }

  /* ─── Prose ─── */

  .prose {
    max-width: var(--prose-max);
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-ink);
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--color-ink);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
  }

  .prose :global(p) {
    margin: 0 0 var(--space-6);
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-accent-subtle);
    transition: text-decoration-color var(--duration-fast) var(--ease-smooth);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-6);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    border-left: 3px solid var(--color-accent);
    background: var(--color-blockquote-bg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-ink-secondary);
    font-style: italic;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 2px 6px;
    background: var(--color-code-bg);
    color: var(--color-code-text);
    border-radius: 4px;
  }

  .prose :global(pre) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.6;
    border: 1px solid var(--color-rule);
    background: var(--color-bg-elevated);
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    border-radius: 0;
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
  }

  .prose :global(hr) {
    margin: var(--space-12) 0;
    border: none;
    border-top: 1px solid var(--color-rule);
  }

  .prose :global(table) {
    width: 100%;
    margin: var(--space-6) 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
  }

  .prose :global(th) {
    font-weight: 600;
    color: var(--color-ink-secondary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  /* ─── Footer ─── */

  .article__footer {
    max-width: var(--prose-max);
    margin-top: var(--space-16);
  }

  .article__footer-rule {
    width: 40px;
    height: 1px;
    background: var(--color-rule-strong);
    margin-bottom: var(--space-6);
  }

  .article__updated {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    margin: 0 0 var(--space-4);
  }

  .article__back {
    font-size: var(--text-sm);
    color: var(--color-accent);
    transition: opacity var(--duration-fast) var(--ease-smooth);
  }

  .article__back:hover {
    opacity: 0.8;
  }

  /* ─── Post Nav ─── */

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    max-width: var(--prose-max);
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-fast) var(--ease-smooth),
                box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .post-nav__link:hover {
    border-color: var(--color-rule-strong);
    box-shadow: var(--shadow-sm);
  }

  .post-nav__link--next {
    text-align: right;
  }

  .post-nav__label {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-nav__title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .post-nav__link:hover .post-nav__title {
    color: var(--color-accent);
  }

  /* ─── Responsive ─── */

  @media (max-width: 1200px) {
    .toc {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .article {
      padding-top: var(--space-8);
    }

    .article__title {
      font-size: var(--text-2xl);
    }

    .post-nav {
      grid-template-columns: 1fr;
    }
  }
</style>
