---
import { getCollection, render } from "astro:content";
import PageLayout from "@/layouts/PageLayout.astro";
import { readingTime, formatDate, postSlug } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const body = (post as any).body ?? "";
const tocHeadings = headings.filter((h) => h.depth <= 3);
---

<PageLayout title={post.data.title} description={post.data.description}>
  <div class="progress-bar" id="progress-bar"></div>

  <article class="article container">
    <header class="article__header">
      <div class="article__meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span class="article__dot" aria-hidden="true" />
        <span>{readingTime(body)}</span>
      </div>
      <h1 class="article__title">{post.data.title}</h1>
      {post.data.description && (
        <p class="article__lead">{post.data.description}</p>
      )}
      {post.data.tags.length > 0 && (
        <div class="article__tags">
          {post.data.tags.map((tag) => (
            <span class="article__tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="article__body">
      {tocHeadings.length >= 3 && (
        <aside class="toc" id="toc">
          <p class="toc__label">Contents</p>
          <nav>
            <ul class="toc__list">
              {tocHeadings.map((h) => (
                <li class:list={["toc__item", `toc__item--${h.depth}`]}>
                  <a class="toc__link" href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <div class="prose">
        <Content />
      </div>
    </div>

    <footer class="article__footer">
      <div class="article__footer-rule" aria-hidden="true" />
      {post.data.lastmod && (
        <p class="article__updated">
          Last updated: {formatDate(post.data.lastmod)}
        </p>
      )}
      <a class="article__back" href="/blog">← Back to all posts</a>
    </footer>
  </article>
</PageLayout>

<script is:inline>
  (function () {
    var bar = document.getElementById("progress-bar");
    if (!bar) return;
    var ticking = false;
    window.addEventListener("scroll", function () {
      if (!ticking) {
        requestAnimationFrame(function () {
          var h = document.documentElement.scrollHeight - window.innerHeight;
          var pct = h > 0 ? (window.scrollY / h) * 100 : 0;
          bar.style.width = pct + "%";
          ticking = false;
        });
        ticking = true;
      }
    });
  })();
</script>

<style>
  /* ─── Progress Bar ─── */

  .progress-bar {
    position: fixed;
    top: 64px;
    left: 0;
    height: 2px;
    width: 0;
    background: var(--color-accent);
    z-index: 40;
    transition: width 60ms linear;
  }

  /* ─── Article ─── */

  .article {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .article__header {
    max-width: var(--prose-max);
    margin-bottom: var(--space-12);
  }

  .article__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .article__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-ink-tertiary);
    opacity: 0.5;
  }

  .article__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .article__lead {
    margin: var(--space-4) 0 0;
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--color-ink-secondary);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .article__tag {
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-ink-tertiary);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
  }

  /* ─── Body with TOC ─── */

  .article__body {
    position: relative;
  }

  .toc {
    position: fixed;
    top: 96px;
    right: max(calc((100vw - var(--layout-max)) / 2), 24px);
    width: 200px;
    max-height: calc(100vh - 140px);
    overflow-y: auto;
    font-size: var(--text-xs);
  }

  .toc__label {
    margin: 0 0 var(--space-2);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    line-height: 1.4;
  }

  .toc__item--2 { padding-left: 0; }
  .toc__item--3 { padding-left: var(--space-3); }

  .toc__link {
    display: block;
    padding: 3px 0;
    color: var(--color-ink-tertiary);
    transition: color var(--duration-fast) var(--ease-smooth);
    border-left: 2px solid transparent;
    padding-left: var(--space-2);
  }

  .toc__link:hover {
    color: var(--color-accent);
  }

  /* ─── Prose ─── */

  .prose {
    max-width: var(--prose-max);
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-ink);
  }

  .prose :global(h1),
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    color: var(--color-ink);
  }

  .prose :global(h2) {
    font-size: var(--text-2xl);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .prose :global(h3) {
    font-size: var(--text-xl);
  }

  .prose :global(p) {
    margin: 0 0 var(--space-6);
  }

  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-accent-subtle);
    transition: text-decoration-color var(--duration-fast) var(--ease-smooth);
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-6);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .prose :global(blockquote) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    border-left: 3px solid var(--color-accent);
    background: var(--color-blockquote-bg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-ink-secondary);
    font-style: italic;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 2px 6px;
    background: var(--color-code-bg);
    color: var(--color-code-text);
    border-radius: 4px;
  }

  .prose :global(pre) {
    margin: var(--space-6) 0;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.6;
    border: 1px solid var(--color-rule);
    background: var(--color-bg-elevated);
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
    border-radius: 0;
  }

  .prose :global(img) {
    border-radius: var(--radius-md);
    margin: var(--space-6) 0;
  }

  .prose :global(hr) {
    margin: var(--space-12) 0;
    border: none;
    border-top: 1px solid var(--color-rule);
  }

  .prose :global(table) {
    width: 100%;
    margin: var(--space-6) 0;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-rule);
    text-align: left;
  }

  .prose :global(th) {
    font-weight: 600;
    color: var(--color-ink-secondary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  /* ─── Footer ─── */

  .article__footer {
    max-width: var(--prose-max);
    margin-top: var(--space-16);
  }

  .article__footer-rule {
    width: 40px;
    height: 1px;
    background: var(--color-rule-strong);
    margin-bottom: var(--space-6);
  }

  .article__updated {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    margin: 0 0 var(--space-4);
  }

  .article__back {
    font-size: var(--text-sm);
    color: var(--color-accent);
    transition: opacity var(--duration-fast) var(--ease-smooth);
  }

  .article__back:hover {
    opacity: 0.8;
  }

  /* ─── Responsive ─── */

  @media (max-width: 1200px) {
    .toc {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .article {
      padding-top: var(--space-8);
    }

    .article__title {
      font-size: var(--text-2xl);
    }
  }
</style>
