---
import PageLayout from "@/layouts/PageLayout.astro";
import { getPublishedPosts, formatDate, readingTime, postSlug } from "@/lib/blog";

const posts = await getPublishedPosts();

// Group posts by year
const grouped = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  if (!grouped.has(year)) grouped.set(year, []);
  grouped.get(year)!.push(post);
}
const years = [...grouped.keys()].sort((a, b) => b - a);
---

<PageLayout title="Archives" description="All posts by year.">
  <section class="archives container">
    <header class="archives__header">
      <p class="archives__eyebrow">Timeline</p>
      <h1 class="archives__title">Archives</h1>
      <p class="archives__desc">
        {posts.length} posts — from {years[years.length - 1]} to {years[0]}.
      </p>
    </header>

    <div class="timeline">
      {years.map((year) => (
        <div class="timeline__year">
          <h2 class="timeline__year-label">{year}</h2>
          <ul class="timeline__list">
            {grouped.get(year)!.map((post) => {
              const body = (post as any).body ?? "";
              return (
                <li class="timeline__item">
                  <a class="timeline__link" href={`/blog/${postSlug(post)}`}>
                    <time class="timeline__date" datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                    </time>
                    <span class="timeline__title">{post.data.title}</span>
                    <span class="timeline__reading">{readingTime(body)}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="archives__back">
      <a href="/blog">← Back to blog</a>
    </div>
  </section>
</PageLayout>

<style>
  .archives {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    max-width: var(--prose-max);
  }

  .archives__header {
    margin-bottom: var(--space-12);
  }

  .archives__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .archives__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .archives__desc {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-lg);
  }

  /* ─── Timeline ─── */

  .timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .timeline__year-label {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    color: var(--color-ink);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  .timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline__item {
    border-bottom: 1px solid var(--color-rule);
  }

  .timeline__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    transition: padding-left var(--duration-fast) var(--ease-smooth);
  }

  .timeline__link:hover {
    padding-left: var(--space-2);
  }

  .timeline__date {
    flex-shrink: 0;
    width: 5.5em;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.02em;
  }

  .timeline__title {
    flex: 1;
    font-size: var(--text-sm);
    color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-smooth);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .timeline__link:hover .timeline__title {
    color: var(--color-accent);
  }

  .timeline__reading {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    font-family: var(--font-mono);
  }

  /* ─── Back ─── */

  .archives__back {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .archives__back a {
    font-size: var(--text-sm);
    color: var(--color-accent);
    transition: opacity var(--duration-fast) var(--ease-smooth);
  }

  .archives__back a:hover {
    opacity: 0.7;
  }

  /* ─── Responsive ─── */

  @media (max-width: 640px) {
    .archives {
      padding-top: var(--space-8);
    }

    .archives__title {
      font-size: var(--text-3xl);
    }

    .timeline__link {
      flex-wrap: wrap;
    }

    .timeline__reading {
      display: none;
    }
  }
</style>
