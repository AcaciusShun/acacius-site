---
import PageLayout from "@/layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
---

<PageLayout title="About" description="Builder, writer, and systems designer.">
  <section class="about container">
    <p class="about__eyebrow">About</p>
    <h1 class="about__title">Somlar</h1>

    <div class="about__content">
      <p class="about__lead">
        Builder, writer, and systems designer.
      </p>
      <p>
        Working at the intersection of technology and narrative systems.
        Building things that are useful, writing things that are honest,
        and designing systems that last.
      </p>
      <p>
        This site is a calm home for experiments, writing, and projects —
        built to stay useful over time.
      </p>
    </div>

    <div class="about__links">
      <a href="https://github.com/AcaciusShun" class="about__link" aria-label="GitHub" target="_blank" rel="noopener">
        <Icon name="simple-icons:github" />
      </a>
      <a href="https://x.com/hey_akie" class="about__link" aria-label="X (Twitter)" target="_blank" rel="noopener">
        <Icon name="simple-icons:x" />
      </a>
      <a href="https://m.somincola.org/@acacius" class="about__link" aria-label="Mastodon" target="_blank" rel="me noopener">
        <Icon name="simple-icons:mastodon" />
      </a>
      <a href="mailto:contact@somlar.com" class="about__link" aria-label="Email">
        <Icon name="lucide:mail" />
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .about {
    padding-top: var(--space-24);
    padding-bottom: var(--space-16);
    max-width: var(--prose-max);
  }

  .about__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .about__title {
    margin: 0 0 var(--space-8);
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .about__content {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-ink-secondary);
  }

  .about__content p {
    margin: 0 0 var(--space-6);
  }

  .about__lead {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-ink);
    font-weight: 500;
    font-style: italic;
    line-height: 1.5;
  }

  .about__links {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .about__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    color: var(--color-ink-tertiary);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-full);
    transition: color var(--duration-fast) var(--ease-smooth),
                border-color var(--duration-fast) var(--ease-smooth),
                background-color var(--duration-fast) var(--ease-smooth);
  }

  .about__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .about__link :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
