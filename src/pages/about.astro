---
import PageLayout from "@/layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";

const skills = [
  { group: "Frontend", items: ["TypeScript", "React", "Vue", "Next.js", "Astro", "React Native", "Expo", "HTML5", "CSS3"] },
  { group: "Tooling", items: ["Vite", "Webpack", "Tailwind CSS"] },
  { group: "Backend", items: ["Node.js", "Python", "FastAPI", "JavaScript"] },
  { group: "Database", items: ["MongoDB", "Redis"] },
  { group: "Infra", items: ["Docker", "Cloudflare", "GitHub Actions"] },
  { group: "Interests", items: ["Systems Design", "Typography", "RSS/Fediverse"] },
];

const timeline = [
  { year: "2026", text: "Building Somlar — a calm personal site as a long-term creative home." },
  { year: "2025", text: "Launched Somincola, a self-hosted Mastodon community." },
  { year: "2024", text: "Completed the HKUST Full-Stack Web Development specialization." },
];
---

<PageLayout title="About" description="Builder, writer, and systems designer.">
  <section class="about container">
    <header class="about__header">
      <p class="about__eyebrow">About</p>
      <h1 class="about__title">Somlar</h1>
    </header>

    <div class="about__content">
      <p class="about__lead">
        Builder, writer, and systems designer.
      </p>
      <p>
        Working at the intersection of technology and narrative systems.
        Building things that are useful, writing things that are honest,
        and designing systems that last.
      </p>
      <p>
        This site is a calm home for experiments, writing, and projects —
        built to stay useful over time.
      </p>
    </div>

    <!-- Skills -->
    <div class="about__section">
      <h2 class="about__section-title">Stack</h2>
      <div class="skills">
        {skills.map((group) => (
          <>
            <span class="skills__label">{group.group}</span>
            <div class="skills__tags">
              {group.items.map((item) => (
                <span class="skills__tag">{item}</span>
              ))}
            </div>
          </>
        ))}
      </div>
    </div>

    <!-- Timeline -->
    <div class="about__section">
      <h2 class="about__section-title">Timeline</h2>
      <ul class="tl">
        {timeline.map((item) => (
          <li class="tl__item">
            <span class="tl__year">{item.year}</span>
            <span class="tl__text">{item.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Links -->
    <div class="about__section">
      <h2 class="about__section-title">Elsewhere</h2>
      <div class="about__links">
        <a href="https://github.com/AcaciusShun" class="about__link" target="_blank" rel="noopener">
          <Icon name="simple-icons:github" />
          <span>GitHub</span>
        </a>
        <a href="https://x.com/hey_akie" class="about__link" target="_blank" rel="noopener">
          <Icon name="simple-icons:x" />
          <span>X</span>
        </a>
        <a href="https://m.somincola.org/@acacius" class="about__link" target="_blank" rel="me noopener">
          <Icon name="simple-icons:mastodon" />
          <span>Mastodon</span>
        </a>
        <a href="mailto:contact@somlar.com" class="about__link">
          <Icon name="lucide:mail" />
          <span>Email</span>
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .about {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    max-width: var(--prose-max);
  }

  .about__header {
    margin-bottom: var(--space-8);
  }

  .about__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .about__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .about__content {
    font-size: var(--text-lg);
    line-height: 1.8;
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-12);
  }

  .about__content p {
    margin: 0 0 var(--space-6);
  }

  .about__lead {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--color-ink);
    font-weight: 500;
    font-style: italic;
    line-height: 1.5;
  }

  /* ─── Sections ─── */

  .about__section {
    margin-bottom: var(--space-12);
  }

  .about__section-title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-rule);
  }

  /* ─── Skills ─── */

  .skills {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3) var(--space-6);
    align-items: baseline;
  }

  .skills__label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
    white-space: nowrap;
  }

  .skills__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skills__tag {
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-ink-secondary);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
  }

  /* ─── Timeline ─── */

  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tl__item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .tl__year {
    flex-shrink: 0;
    width: 4em;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 500;
  }

  .tl__text {
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    line-height: 1.6;
  }

  /* ─── Links ─── */

  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .about__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-ink-secondary);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-full);
    transition: color var(--duration-fast) var(--ease-smooth),
                border-color var(--duration-fast) var(--ease-smooth),
                background-color var(--duration-fast) var(--ease-smooth);
  }

  .about__link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .about__link :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* ─── Responsive ─── */

  @media (max-width: 640px) {
    .about {
      padding-top: var(--space-8);
    }

    .about__title {
      font-size: var(--text-3xl);
    }

    .skills {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .skills__tags {
      margin-bottom: var(--space-3);
    }
  }
</style>
