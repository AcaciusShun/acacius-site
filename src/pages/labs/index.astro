---
import PageLayout from "@/layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";

const labs = [
  {
    name: "Football Reincarnation",
    desc: "足坛投胎模拟器 — a short, bilingual what-if quiz. Your choices through football's iconic moments nudge five hidden trait axes, then match you to a real legend (or a tongue-in-cheek meme ending).",
    tech: ["React", "Vite", "TypeScript"],
    repo: "https://github.com/AcaciusShun/football-reincarnation",
    url: "https://acaciusshun.github.io/football-reincarnation/",
  },
];
---

<PageLayout title="Labs" description="Experiments, prototypes, and small demos.">
  <section class="labs container">
    <header class="labs__header">
      <p class="labs__eyebrow">Experiments</p>
      <h1 class="labs__title">Labs</h1>
      <p class="labs__desc">Prototypes, small demos, and interface drafts.</p>
    </header>

    <div class="labs__grid animate-stagger-in">
      {labs.map((lab) => (
        <article class="card">
          <div class="card__body">
            <h3 class="card__name">{lab.name}</h3>
            <p class="card__desc">{lab.desc}</p>
            <div class="card__tech">
              {lab.tech.map((t) => (
                <span class="card__tag">{t}</span>
              ))}
            </div>
          </div>
          <div class="card__links">
            {lab.url && (
              <a href={lab.url} class="card__link" target="_blank" rel="noopener" aria-label={`Play ${lab.name}`}>
                <Icon name="lucide:play" />
                <span>Play</span>
              </a>
            )}
            <a href={lab.repo} class="card__link" target="_blank" rel="noopener" aria-label={`${lab.name} source code`}>
              <Icon name="simple-icons:github" />
              <span>Source</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</PageLayout>

<style>
  .labs {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .labs__header {
    margin-bottom: var(--space-12);
  }

  .labs__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .labs__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .labs__desc {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-lg);
  }

  /* ─── Grid ─── */

  .labs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  /* ─── Card ─── */

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-warm);
    transition: border-color var(--duration-fast) var(--ease-smooth),
                box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .card:hover {
    border-color: var(--color-rule-strong);
    box-shadow: var(--shadow-sm);
  }

  .card__body {
    flex: 1;
    padding: var(--space-6);
  }

  .card__name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .card__desc {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  .card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card__tag {
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-ink-tertiary);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
  }

  .card__links {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .card__link:hover {
    color: var(--color-accent);
  }

  .card__link :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* ─── Responsive ─── */

  @media (max-width: 640px) {
    .labs {
      padding-top: var(--space-8);
    }

    .labs__title {
      font-size: var(--text-3xl);
    }

    .labs__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
