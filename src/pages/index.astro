---
import PageLayout from "@/layouts/PageLayout.astro";
import { getPublishedPosts, formatDate, postSlug, readingTime } from "@/lib/blog";
import { fetchLibraryItems } from "@/lib/neodb";
import MediaCover from "@/components/content/MediaCover.astro";
import RatingStars from "@/components/content/RatingStars.astro";
import LibraryModal from "@/components/content/LibraryModal.astro";
import CategoryBadge from "@/components/content/CategoryBadge.astro";

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 4);

const recentLibrary = (await fetchLibraryItems()).slice(0, 6);
const shelfLabel: Record<string, string> = {
  complete: "看过",
  progress: "在看",
  wishlist: "想看",
  dropped: "弃",
};
---

<PageLayout>
  <section class="hero container">
    <p class="hero__eyebrow">Personal Study</p>
    <h1 class="hero__title">
      Still writing,<br />
      still building.
    </h1>
    <p class="hero__subtitle">
      Experiments, essays, and selected work — from one clear starting point.
    </p>
  </section>

  <section class="sections container animate-stagger-in">
    <div class="sections__grid">
      <!-- Latest Writing -->
      <div class="section-card section-card--wide">
        <div class="section-card__header">
          <span class="section-card__index">01</span>
          <h2 class="section-card__title">Latest</h2>
        </div>
        <p class="section-card__desc">Recent essays, notes, and working logs.</p>
        <ul class="section-card__list">
          {latestPosts.map((post) => (
            <li class="section-card__item">
              <a class="section-card__item-link" href={`/blog/${postSlug(post)}`}>
                <span class="section-card__item-title">{post.data.title}</span>
                <span class="section-card__item-meta">
                  {readingTime((post as any).body ?? "")}
                  <span class="section-card__item-dot" aria-hidden="true" />
                  {formatDate(post.data.date)}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a class="section-card__cta" href="/blog">
          Read all
          <span class="section-card__arrow" aria-hidden="true"></span>
        </a>
      </div>

      <!-- Projects -->
      <div class="section-card">
        <div class="section-card__header">
          <span class="section-card__index">02</span>
          <h2 class="section-card__title">Projects</h2>
        </div>
        <p class="section-card__desc">Selected builds and references.</p>
        <ul class="section-card__tags-list">
          <li class="section-card__tags-item">
            <span class="section-card__tags-name">Somlar</span>
            <span class="section-card__tags-tech">Astro · TypeScript</span>
          </li>
          <li class="section-card__tags-item">
            <span class="section-card__tags-name">Somincola</span>
            <span class="section-card__tags-tech">Ruby · Docker</span>
          </li>
          <li class="section-card__tags-item">
            <span class="section-card__tags-name">News Center</span>
            <span class="section-card__tags-tech">Python · FastAPI</span>
          </li>
        </ul>
        <a class="section-card__cta" href="/projects">
          View all
          <span class="section-card__arrow" aria-hidden="true"></span>
        </a>
      </div>

      <!-- Labs -->
      <div class="section-card">
        <div class="section-card__header">
          <span class="section-card__index">03</span>
          <h2 class="section-card__title">Labs</h2>
        </div>
        <p class="section-card__desc">Experiments, prototypes, and small demos.</p>
        <a class="section-card__cta" href="/labs">
          Explore
          <span class="section-card__arrow" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  {recentLibrary.length > 0 && (
    <section class="lately container">
      <div class="lately__head">
        <div>
          <p class="lately__eyebrow">Lately</p>
          <h2 class="lately__title">From the Library</h2>
        </div>
        <a class="lately__cta" href="/library">
          View all
          <span class="section-card__arrow" aria-hidden="true"></span>
        </a>
      </div>
      <div class="lately__row">
        {recentLibrary.map((it) => (
          <a class="lately__item" href={it.url} target="_blank" rel="noopener" data-lib-open={it.uuid} aria-label={it.title}>
            <div class="lately__cover">
              <MediaCover title={it.title} category={it.category} cover={it.cover} />
              <CategoryBadge category={it.category} />
            </div>
            <p class="lately__item-title">{it.title}</p>
            {it.rating ? (
              <RatingStars rating={it.rating} />
            ) : (
              <span class="lately__status">{shelfLabel[it.shelf]}</span>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  {recentLibrary.length > 0 && <LibraryModal items={recentLibrary} />}

  <footer class="colophon container">
    <div class="colophon__rule" aria-hidden="true" />
    <p class="colophon__text">A calm space for writing, building, and thinking.</p>
  </footer>
</PageLayout>

<style>
  /* ─── Hero ─── */

  .hero {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, var(--text-5xl));
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    word-break: break-word;
  }

  .hero__subtitle {
    margin: var(--space-6) 0 0;
    max-width: 48ch;
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-ink-secondary);
  }

  /* ─── Section Cards ─── */

  .sections {
    padding-bottom: var(--space-12);
  }

  .sections__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-4);
    max-width: 100%;
  }

  .section-card {
    position: relative;
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-rule);
    box-shadow: var(--shadow-md);
    min-width: 0;
    transition: transform var(--duration-normal) var(--ease-smooth),
                box-shadow var(--duration-normal) var(--ease-smooth),
                border-color var(--duration-normal) var(--ease-smooth);
  }

  .section-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-rule-strong);
  }

  .section-card--wide {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
  }

  .section-card__header {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .section-card__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.08em;
  }

  .section-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    word-break: break-word;
  }

  .section-card__desc {
    margin: 0 0 var(--space-4);
    color: var(--color-ink-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .section-card__list {
    list-style: none;
    margin: 0 0 var(--space-6);
    padding: 0;
    flex: 1;
    width: 100%;
    min-width: 0;
  }

  .section-card__item {
    border-bottom: 1px solid var(--color-rule);
    max-width: 100%;
    overflow: hidden;
  }

  .section-card__item-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    transition: padding-left var(--duration-fast) var(--ease-smooth);
  }

  .section-card__item-link:hover {
    padding-left: var(--space-1);
  }

  .section-card__item-title {
    font-size: var(--text-sm);
    color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-smooth);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }

  .section-card__item-link:hover .section-card__item-title {
    color: var(--color-accent);
  }

  .section-card__item-meta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .section-card__item-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-ink-tertiary);
    opacity: 0.5;
  }

  .section-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-top: auto;
  }

  .section-card__arrow {
    display: inline-block;
    width: 16px;
    height: 1px;
    background: currentColor;
    transition: transform var(--duration-fast) var(--ease-smooth);
  }

  .section-card:hover .section-card__arrow {
    transform: translateX(5px);
  }

  /* ─── Project Tags ─── */

  .section-card__tags-list {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .section-card__tags-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-rule);
    min-width: 0;
  }

  .section-card__tags-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }

  .section-card__tags-tech {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    font-family: var(--font-mono);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* ─── Lately (Library strip) ─── */

  .lately {
    padding-bottom: var(--space-24);
  }

  .lately__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .lately__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .lately__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 600;
    line-height: 1.2;
  }

  .lately__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .lately__cta:hover .section-card__arrow {
    transform: translateX(5px);
  }

  .lately__row {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-4);
  }

  .lately__item {
    display: block;
    min-width: 0;
  }

  .lately__cover {
    position: relative;
    transition: transform var(--duration-normal) var(--ease-smooth);
  }

  .lately__item:hover .lately__cover {
    transform: translateY(-4px);
  }

  .lately__item-title {
    margin: var(--space-3) 0 var(--space-1);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lately__item:hover .lately__item-title {
    color: var(--color-accent);
  }

  .lately__status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
  }

  /* ─── Colophon ─── */

  .colophon {
    padding-bottom: var(--space-16);
  }

  .colophon__rule {
    width: 40px;
    height: 1px;
    background: var(--color-rule-strong);
    margin-bottom: var(--space-4);
  }

  .colophon__text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-tertiary);
    font-style: italic;
  }

  /* ─── Crimson Nocturne ─── */

  :global(html[data-skin="nocturne"]) .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    min-height: clamp(470px, 62vw, 660px);
    margin-top: var(--space-8);
    margin-bottom: var(--space-12);
    padding-top: clamp(70px, 9vw, 112px);
    padding-bottom: clamp(70px, 9vw, 112px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent) 52%, transparent);
    background-image:
      linear-gradient(90deg, rgba(7, 8, 20, 0.98) 0%, rgba(7, 8, 20, 0.9) 35%, rgba(7, 8, 20, 0.2) 68%, rgba(7, 8, 20, 0.02) 100%),
      url("/images/themes/crimson-nocturne/home-hero.webp");
    background-position: center;
    background-size: cover;
    box-shadow: var(--shadow-lg);
    clip-path: polygon(0 0, calc(100% - 34px) 0, 100% 34px, 100% calc(100% - 22px), calc(100% - 22px) 100%, 24px 100%, 0 calc(100% - 24px));
  }

  :global(html[data-skin="nocturne"]) .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(125deg, transparent 60%, rgba(255, 55, 111, 0.09)),
      repeating-linear-gradient(0deg, rgba(242, 238, 223, 0.025) 0 1px, transparent 1px 5px);
    mix-blend-mode: screen;
  }

  :global(html[data-skin="nocturne"]) .hero::after {
    content: "MIDNIGHT FORM / 02";
    position: absolute;
    right: clamp(16px, 3vw, 38px);
    bottom: clamp(14px, 2vw, 24px);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    color: rgba(242, 238, 223, 0.55);
  }

  :global(html[data-skin="nocturne"]) .hero__eyebrow {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin-bottom: var(--space-4);
    padding: 3px 10px 3px 17px;
    font-family: var(--font-mono);
    color: var(--color-accent);
    background: rgba(255, 55, 111, 0.1);
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
  }

  :global(html[data-skin="nocturne"]) .hero__eyebrow::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 50%;
    width: 4px;
    height: 4px;
    background: currentColor;
    transform: translateY(-50%) rotate(45deg);
  }

  :global(html[data-skin="nocturne"]) .hero__title {
    position: relative;
    z-index: 1;
    max-width: 8.5ch;
    font-size: clamp(3.15rem, 7.5vw, 6rem);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.07em;
    text-transform: uppercase;
    text-shadow: 5px 5px 0 var(--color-nocturne-wine), 9px 9px 0 rgba(9, 11, 24, 0.8);
    transform: skewX(-3deg);
  }

  :global(html[data-skin="nocturne"]) .hero__subtitle {
    position: relative;
    z-index: 1;
    max-width: 35ch;
    color: var(--color-ink-secondary);
  }

  :global(html[data-skin="nocturne"]) .sections__grid {
    gap: var(--space-5, 1.25rem);
  }

  :global(html[data-skin="nocturne"]) .section-card {
    overflow: hidden;
    border-color: color-mix(in srgb, var(--color-accent) 22%, var(--color-rule));
    background:
      linear-gradient(135deg, rgba(255, 55, 111, 0.045), transparent 42%),
      var(--color-bg-elevated);
    box-shadow: var(--shadow-md);
    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }

  :global(html[data-skin="nocturne"]) .section-card::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 54px;
    height: 54px;
    pointer-events: none;
    background: linear-gradient(135deg, transparent 47%, rgba(255, 55, 111, 0.38) 48% 52%, rgba(88, 21, 47, 0.65) 53%);
    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }

  :global(html[data-skin="nocturne"]) .section-card:hover {
    transform: translate(-2px, -4px);
    border-color: color-mix(in srgb, var(--color-accent) 58%, transparent);
    box-shadow: var(--shadow-lg);
  }

  :global(html[data-skin="nocturne"]) .section-card--wide {
    border-left: 3px solid var(--color-accent);
  }

  :global(html[data-skin="nocturne"]) .section-card__index {
    color: var(--color-accent);
  }

  :global(html[data-skin="nocturne"]) .section-card__title,
  :global(html[data-skin="nocturne"]) .lately__title {
    font-weight: 850;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  :global(html[data-skin="nocturne"]) .section-card__item {
    border-image: linear-gradient(90deg, var(--color-rule), transparent) 1;
  }

  :global(html[data-skin="nocturne"]) .section-card__cta,
  :global(html[data-skin="nocturne"]) .lately__cta {
    font-family: var(--font-mono);
    font-weight: 600;
  }

  :global(html[data-skin="nocturne"]) .lately__eyebrow {
    color: var(--color-accent);
  }

  :global(html[data-skin="nocturne"]) .lately__cover {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
    background: var(--color-bg-elevated);
    box-shadow: 3px 3px 0 rgba(88, 21, 47, 0.42);
    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 9px, 100% 100%, 0 100%);
  }

  :global(html[data-skin="nocturne"]) .lately__item:hover .lately__cover {
    transform: translate(-1px, -5px) rotate(-0.4deg);
  }

  :global(html[data-skin="nocturne"]) .lately__item-title {
    font-family: var(--font-body);
    font-weight: 650;
  }

  :global(html[data-skin="nocturne"]) .colophon__rule {
    width: 120px;
    height: 5px;
    background: repeating-linear-gradient(115deg, var(--color-accent) 0 12px, transparent 12px 18px);
    clip-path: polygon(0 50%, 8px 0, 17px 50%, 28px 0, 38px 50%, 48px 0, 100% 50%, 48px 100%, 38px 50%, 28px 100%, 17px 50%, 8px 100%);
  }

  /* ─── Responsive ─── */

  @media (max-width: 768px) {
    .hero {
      padding-top: var(--space-16);
      padding-bottom: var(--space-12);
    }

    .sections__grid {
      grid-template-columns: 1fr;
    }

    .section-card--wide {
      grid-row: auto;
    }

    .lately__row {
      grid-template-columns: repeat(3, 1fr);
    }

    :global(html[data-skin="nocturne"]) .hero {
      min-height: 530px;
      margin-top: var(--space-4);
      margin-bottom: var(--space-8);
      background-image:
        linear-gradient(90deg, rgba(7, 8, 20, 0.98) 0%, rgba(7, 8, 20, 0.86) 46%, rgba(7, 8, 20, 0.3) 100%),
        url("/images/themes/crimson-nocturne/home-hero.webp");
      background-position: 58% center;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: var(--space-12);
      padding-bottom: var(--space-8);
    }

    .hero__title {
      font-size: var(--text-3xl);
    }

    .hero__subtitle {
      font-size: var(--text-base);
    }

    .section-card {
      padding: var(--space-6) var(--space-4);
    }

    .section-card__title {
      font-size: var(--text-2xl);
    }

    .section-card__item-link {
      flex-direction: column;
      gap: var(--space-1);
    }

    .section-card__item-meta {
      align-self: flex-start;
    }

    .sections {
      padding-bottom: var(--space-8);
    }

    :global(html[data-skin="nocturne"]) .hero {
      min-height: 470px;
      padding: var(--space-12) var(--space-6);
      background-image:
        linear-gradient(90deg, rgba(7, 8, 20, 0.99) 0%, rgba(7, 8, 20, 0.88) 54%, rgba(7, 8, 20, 0.4) 100%),
        url("/images/themes/crimson-nocturne/home-hero.webp");
      background-position: 61% center;
      clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0 calc(100% - 14px));
    }

    :global(html[data-skin="nocturne"]) .hero__title {
      max-width: 7.5ch;
      font-size: clamp(2.7rem, 14vw, 4rem);
      text-shadow: 4px 4px 0 var(--color-nocturne-wine);
    }

    :global(html[data-skin="nocturne"]) .hero__subtitle {
      max-width: 26ch;
      font-size: var(--text-sm);
    }
  }
</style>
