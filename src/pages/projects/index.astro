---
import PageLayout from "@/layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";

const projects = [
  {
    name: "Somlar",
    desc: "Personal site built with Astro 6, featuring a \"Digital Study\" design system with light/dark themes, content collections, and editorial typography.",
    tech: ["Astro", "TypeScript", "CSS"],
    repo: "https://github.com/somlar/somlar-site",
    url: "https://somlar.com",
    category: "personal",
  },
  {
    name: "Somincola",
    desc: "Self-hosted Mastodon community with custom branding, moderation policies, and a companion landing site.",
    tech: ["Ruby", "Astro", "Docker"],
    repo: "https://github.com/somincola",
    url: "https://somincola.org",
    category: "personal",
  },
  {
    name: "Mastodon News Center",
    desc: "News bot management system for Mastodon — automates RSS feed aggregation and publishing across multiple bot accounts.",
    tech: ["Python", "FastAPI", "Docker"],
    repo: "https://github.com/somincola/mastodon-news-center",
    category: "personal",
  },
  {
    name: "Moro",
    desc: "Native iOS client for Mastodon with timeline browsing, posting, and notification support.",
    tech: ["Swift", "SwiftUI", "iOS"],
    repo: "https://github.com/somincola/moro-ios",
    category: "personal",
  },
  {
    name: "Front-End Web Development with React",
    desc: "Coursera specialization project — single-page restaurant app with React, Redux, and React Router.",
    tech: ["React", "Redux", "JavaScript"],
    repo: "https://github.com/coursera-learn/Front-End-Web-Development-with-React",
    category: "course",
  },
  {
    name: "Server-side Development with Node.js",
    desc: "Coursera specialization project — RESTful API server with Express, MongoDB, and authentication.",
    tech: ["Node.js", "Express", "MongoDB"],
    repo: "https://github.com/coursera-learn/Server-side-Development-with-NodeJS-Express-and-MongoDB",
    category: "course",
  },
  {
    name: "Full-Stack Web & Mobile App",
    desc: "Coursera capstone — cross-platform mobile app with Ionic/React Native and a full-stack backend.",
    tech: ["Ionic", "React Native", "HTML"],
    repo: "https://github.com/coursera-learn/Full-Stack-Web-and-Multiplatform-Mobile-App-",
    category: "course",
  },
];

const personal = projects.filter((p) => p.category === "personal");
const course = projects.filter((p) => p.category === "course");
---

<PageLayout title="Projects" description="Selected builds, tools, and references.">
  <section class="projects container">
    <header class="projects__header">
      <p class="projects__eyebrow">Work</p>
      <h1 class="projects__title">Projects</h1>
      <p class="projects__desc">Selected builds, tools, and open-source work.</p>
    </header>

    <div class="projects__section">
      <h2 class="projects__section-title">Personal Projects</h2>
      <div class="projects__grid animate-stagger-in">
        {personal.map((p) => (
          <article class="card">
            <div class="card__body">
              <h3 class="card__name">{p.name}</h3>
              <p class="card__desc">{p.desc}</p>
              <div class="card__tech">
                {p.tech.map((t) => (
                  <span class="card__tag">{t}</span>
                ))}
              </div>
            </div>
            <div class="card__links">
              <a href={p.repo} class="card__link" target="_blank" rel="noopener" aria-label={`${p.name} source code`}>
                <Icon name="simple-icons:github" />
                <span>Source</span>
              </a>
              {p.url && (
                <a href={p.url} class="card__link" target="_blank" rel="noopener" aria-label={`${p.name} live site`}>
                  <Icon name="lucide:external-link" />
                  <span>Visit</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="projects__section">
      <h2 class="projects__section-title">Course Projects</h2>
      <p class="projects__section-desc">Completed during the Hong Kong University of Science and Technology Full-Stack specialization on Coursera.</p>
      <div class="projects__grid animate-stagger-in">
        {course.map((p) => (
          <article class="card">
            <div class="card__body">
              <h3 class="card__name">{p.name}</h3>
              <p class="card__desc">{p.desc}</p>
              <div class="card__tech">
                {p.tech.map((t) => (
                  <span class="card__tag">{t}</span>
                ))}
              </div>
            </div>
            <div class="card__links">
              <a href={p.repo} class="card__link" target="_blank" rel="noopener" aria-label={`${p.name} source code`}>
                <Icon name="simple-icons:github" />
                <span>Source</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .projects {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .projects__header {
    margin-bottom: var(--space-12);
  }

  .projects__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .projects__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
  }

  .projects__desc {
    margin: var(--space-4) 0 0;
    color: var(--color-ink-secondary);
    font-size: var(--text-lg);
  }

  /* ─── Sections ─── */

  .projects__section {
    margin-bottom: var(--space-12);
  }

  .projects__section-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-ink);
  }

  .projects__section-desc {
    margin: 0 0 var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-ink-tertiary);
  }

  .projects__section-title + .projects__grid {
    margin-top: var(--space-6);
  }

  /* ─── Grid ─── */

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  /* ─── Card ─── */

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--color-bg-warm);
    transition: border-color var(--duration-fast) var(--ease-smooth),
                box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .card:hover {
    border-color: var(--color-rule-strong);
    box-shadow: var(--shadow-sm);
  }

  .card__body {
    flex: 1;
    padding: var(--space-6);
  }

  .card__name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }

  .card__desc {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-secondary);
  }

  .card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .card__tag {
    padding: 2px var(--space-2);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-ink-tertiary);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
  }

  .card__links {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-6);
    border-top: 1px solid var(--color-rule);
  }

  .card__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .card__link:hover {
    color: var(--color-accent);
  }

  .card__link :global(svg) {
    width: 14px;
    height: 14px;
  }

  /* ─── Responsive ─── */

  @media (max-width: 640px) {
    .projects {
      padding-top: var(--space-8);
    }

    .projects__title {
      font-size: var(--text-3xl);
    }

    .projects__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
