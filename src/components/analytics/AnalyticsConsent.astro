---
import { siteConfig } from "@/lib/config";

const analyticsEnabled = Boolean(siteConfig.analytics.measurementId);
---

{analyticsEnabled && (
  <aside class="analytics-consent" data-analytics-consent-panel hidden role="region" aria-labelledby="analytics-consent-title">
    <div class="analytics-consent__copy">
      <p class="analytics-consent__eyebrow">Privacy · Analytics</p>
      <h2 id="analytics-consent-title">要允许匿名化的阅读统计吗？</h2>
      <p>
        我使用 Google Analytics 了解哪些文章更有帮助。只有你同意后才会启用统计；脚本通过 Partytown 在 Web Worker 中运行，不用于广告个性化。
      </p>
    </div>
    <div class="analytics-consent__actions">
      <button class="analytics-consent__button analytics-consent__button--quiet" type="button" data-consent-choice="rejected">
        仅必要
      </button>
      <button class="analytics-consent__button analytics-consent__button--accept" type="button" data-consent-choice="accepted">
        允许统计
      </button>
    </div>
  </aside>
)}

{analyticsEnabled && (
  <script is:inline>
    (() => {
      const panel = document.querySelector("[data-analytics-consent-panel]");
      if (!panel || !window.somlarAnalytics) return;

      let returnFocus = null;

      const show = (trigger) => {
        returnFocus = trigger ?? null;
        panel.hidden = false;
        requestAnimationFrame(() => panel.dataset.visible = "true");
      };

      const hide = () => {
        panel.dataset.visible = "false";
        window.setTimeout(() => {
          panel.hidden = true;
          returnFocus?.focus();
          returnFocus = null;
        }, 250);
      };

      panel.querySelectorAll("[data-consent-choice]").forEach((button) => {
        button.addEventListener("click", () => {
          window.somlarAnalytics.setChoice(button.dataset.consentChoice);
          hide();
        });
      });

      document.querySelectorAll("[data-analytics-settings]").forEach((button) => {
        button.addEventListener("click", () => show(button));
      });

      if (window.somlarAnalytics.readChoice() === null) show();
    })();
  </script>
)}

<style>
  .analytics-consent {
    position: fixed;
    z-index: 90;
    right: max(var(--page-gutter), env(safe-area-inset-right));
    bottom: max(var(--space-6), env(safe-area-inset-bottom));
    width: min(680px, calc(100vw - (var(--page-gutter) * 2)));
    padding: clamp(20px, 4vw, 28px);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    backdrop-filter: blur(18px);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity var(--duration-normal) var(--ease-smooth),
      transform var(--duration-normal) var(--ease-smooth);
  }

  .analytics-consent[hidden] {
    display: none;
  }

  .analytics-consent[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  .analytics-consent__copy {
    max-width: 590px;
  }

  .analytics-consent__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .analytics-consent h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 4vw, var(--text-2xl));
    line-height: 1.2;
    color: var(--color-ink);
  }

  .analytics-consent__copy > p:last-child {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-ink-secondary);
  }

  .analytics-consent__actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .analytics-consent__button {
    min-height: 42px;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius-full);
    font: 600 var(--text-sm) / 1 var(--font-body);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-smooth),
      background-color var(--duration-fast) var(--ease-smooth),
      border-color var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-smooth);
  }

  .analytics-consent__button:hover {
    transform: translateY(-1px);
  }

  .analytics-consent__button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .analytics-consent__button--quiet {
    color: var(--color-ink-secondary);
    background: transparent;
  }

  .analytics-consent__button--quiet:hover {
    color: var(--color-ink);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .analytics-consent__button--accept {
    color: var(--color-bg-elevated);
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .analytics-consent__button--accept:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
  }

  :global(html[data-skin="nocturne"]) .analytics-consent {
    border-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    background:
      linear-gradient(135deg, rgba(255, 55, 111, 0.08), transparent 45%),
      var(--color-surface);
    box-shadow: var(--shadow-lg);
    clip-path: polygon(0 0, calc(100% - 15px) 0, 100% 15px, 100% 100%, 8px 100%, 0 calc(100% - 8px));
  }

  :global(html[data-skin="nocturne"]) .analytics-consent h2 {
    font-family: var(--font-body);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  :global(html[data-skin="nocturne"]) .analytics-consent__button {
    clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%);
  }

  @media (max-width: 560px) {
    .analytics-consent {
      right: var(--space-3);
      bottom: max(var(--space-3), env(safe-area-inset-bottom));
      width: calc(100vw - (var(--space-3) * 2));
    }

    .analytics-consent__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .analytics-consent,
    .analytics-consent__button {
      transition: none;
    }
  }
</style>
