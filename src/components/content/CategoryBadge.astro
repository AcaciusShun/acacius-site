---
// Small category badge for a media cover's corner — a frosted chip with the
// category icon tinted in its category color. Must sit inside a
// `position: relative` cover wrapper. Used on the Library grid and the
// homepage "From the Library" strip.
import { Icon } from "astro-icon/components";

interface Props {
  category: string;
}
const { category } = Astro.props;

const icon: Record<string, string> = {
  book: "lucide:book",
  movie: "lucide:film",
  tv: "lucide:tv",
  music: "lucide:music",
  game: "lucide:gamepad-2",
  podcast: "lucide:podcast",
};
const label: Record<string, string> = {
  book: "Book",
  movie: "Film",
  tv: "TV",
  music: "Music",
  game: "Game",
  podcast: "Podcast",
};
---

<span class:list={["cat-badge", `cat-badge--${category}`]} title={label[category] ?? category}>
  <Icon name={icon[category] ?? "lucide:circle"} />
</span>

<style>
  .cat-badge {
    --cat: var(--color-ink-secondary);
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    color: var(--cat);
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--cat) 50%, var(--color-rule));
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .cat-badge :global(svg) {
    width: 13px;
    height: 13px;
  }

  /* Category colors — mid-tones that read on both light and dark frosted chips */
  .cat-badge--book { --cat: #b5784e; }
  .cat-badge--movie { --cat: #6d8cc4; }
  .cat-badge--tv { --cat: #74a85a; }
  .cat-badge--music { --cat: #b56aa0; }
  .cat-badge--game { --cat: #c2984a; }
  .cat-badge--podcast { --cat: #54a6ad; }
</style>
