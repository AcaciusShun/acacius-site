---
// 5-star display for a NeoDB rating_grade (1–10). Fractional via clip-width.
interface Props {
  rating: number | null;
}
const { rating } = Astro.props;
const pct = rating ? Math.round((rating / 10) * 100) : 0;
---

{
  rating ? (
    <span class="stars" role="img" aria-label={`${rating} / 10`}>
      <span class="stars__bar">
        <span class="stars__track">★★★★★</span>
        <span class="stars__fill" style={`width:${pct}%`}>★★★★★</span>
      </span>
      <span class="stars__num">{rating.toFixed(1)}</span>
    </span>
  ) : (
    <span class="stars stars--none">未评分</span>
  )
}

<style>
  .stars {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    line-height: 1;
  }

  .stars__bar {
    position: relative;
    display: inline-block;
    font-size: var(--text-sm);
    letter-spacing: 2px;
    white-space: nowrap;
  }

  .stars__track {
    color: var(--color-rule-strong);
  }

  .stars__fill {
    position: absolute;
    top: 0;
    left: 0;
    overflow: hidden;
    white-space: nowrap;
    color: var(--color-accent);
  }

  .stars__num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
  }

  .stars--none {
    font-size: var(--text-xs);
    color: var(--color-ink-tertiary);
  }
</style>
