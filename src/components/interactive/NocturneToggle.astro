---

<button
  class="nocturne-toggle"
  id="nocturne-toggle"
  type="button"
  aria-label="进入绯红夜曲"
  aria-pressed="false"
  title="Crimson Nocturne"
>
  <span class="nocturne-toggle__emoji nocturne-toggle__emoji--devil" aria-hidden="true">😈</span>
  <span class="nocturne-toggle__emoji nocturne-toggle__emoji--angel" aria-hidden="true">😇</span>
</button>

<script is:inline>
  (function () {
    var button = document.getElementById("nocturne-toggle");
    if (!button || button.dataset.init) return;
    button.dataset.init = "true";

    var root = document.documentElement;
    var storageKey = "somlar-skin";
    var transitioning = false;

    function isNocturne() {
      return root.dataset.skin === "nocturne";
    }

    function syncControls() {
      var active = isNocturne();
      button.setAttribute("aria-pressed", String(active));
      button.setAttribute("aria-label", active ? "退出绯红夜曲" : "进入绯红夜曲");
      button.title = active ? "Return to the standard theme" : "Enter Crimson Nocturne";

      var standardToggle = document.getElementById("theme-toggle");
      if (standardToggle) standardToggle.hidden = active;
    }

    function applySkin(next) {
      if (next) {
        root.dataset.skin = "nocturne";
      } else {
        delete root.dataset.skin;
      }

      try {
        if (next) localStorage.setItem(storageKey, "nocturne");
        else localStorage.removeItem(storageKey);
      } catch (error) {
        // The visual state still works when storage is unavailable.
      }

      syncControls();
      window.dispatchEvent(new CustomEvent("somlar:skinchange", { detail: { skin: next ? "nocturne" : "standard" } }));
    }

    button.addEventListener("click", function () {
      if (transitioning) return;
      transitioning = true;
      button.disabled = true;

      var next = !isNocturne();
      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var transitionMode = next ? "nocturne-transition--enter" : "nocturne-transition--exit";
      var rect = button.getBoundingClientRect();
      root.style.setProperty("--theme-x", rect.left + rect.width / 2 + "px");
      root.style.setProperty("--theme-y", rect.top + rect.height / 2 + "px");

      function release() {
        root.classList.remove(
          "nocturne-transition",
          "nocturne-transition--enter",
          "nocturne-transition--exit"
        );
        button.disabled = false;
        transitioning = false;
      }

      if (!reduceMotion && document.startViewTransition) {
        root.classList.add("nocturne-transition", transitionMode);
        var transition = document.startViewTransition(function () {
          applySkin(next);
        });
        transition.finished.then(release, release);
      } else {
        applySkin(next);
        release();
      }
    });

    syncControls();
  })();
</script>

<style>
  .nocturne-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid rgba(255, 55, 111, 0.86);
    border-radius: 11px 5px 11px 5px;
    color: #fff;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.18), transparent 42%),
      linear-gradient(145deg, #ed2c63, #8e153f);
    box-shadow:
      0 0 0 3px rgba(255, 55, 111, 0.1),
      3px 3px 0 rgba(88, 21, 47, 0.34);
    cursor: pointer;
    isolation: isolate;
    overflow: visible;
    transition:
      border-color var(--duration-fast) var(--ease-smooth),
      background-color var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-bounce),
      box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .nocturne-toggle::before {
    content: "";
    position: absolute;
    inset: 4px;
    z-index: -1;
    border-radius: inherit;
    background: rgba(255, 174, 198, 0.22);
    opacity: 0.42;
    transform: scale(0.72) rotate(-8deg);
    transition:
      opacity var(--duration-fast) var(--ease-smooth),
      transform var(--duration-normal) var(--ease-bounce);
  }

  .nocturne-toggle:hover,
  .nocturne-toggle:focus-visible {
    border-color: #ff7ca2;
    transform: translateY(-1px) rotate(-2deg);
    box-shadow:
      0 0 0 4px rgba(255, 55, 111, 0.15),
      4px 4px 0 rgba(88, 21, 47, 0.4);
  }

  .nocturne-toggle:hover::before,
  .nocturne-toggle:focus-visible::before,
  .nocturne-toggle[aria-pressed="true"]::before {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  .nocturne-toggle:focus-visible {
    outline: 2px solid #ff376f;
    outline-offset: 3px;
  }

  .nocturne-toggle:disabled {
    cursor: wait;
  }

  .nocturne-toggle__emoji {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: 21px;
    line-height: 1;
    transform-origin: 50% 55%;
    transition:
      opacity var(--duration-fast) var(--ease-smooth),
      transform var(--duration-normal) var(--ease-bounce),
      filter var(--duration-normal) var(--ease-smooth);
  }

  .nocturne-toggle__emoji--devil {
    opacity: 1;
    filter: drop-shadow(0 1px 1px rgba(41, 5, 22, 0.66));
    transform: scale(1) rotate(-3deg);
  }

  .nocturne-toggle__emoji--angel {
    opacity: 0;
    filter: drop-shadow(0 0 0 transparent);
    transform: scale(0.58) rotate(14deg);
  }

  .nocturne-toggle:hover .nocturne-toggle__emoji--devil,
  .nocturne-toggle:focus-visible .nocturne-toggle__emoji--devil {
    transform: scale(1.1) rotate(-5deg);
  }

  .nocturne-toggle[aria-pressed="true"] .nocturne-toggle__emoji--devil {
    opacity: 0;
    transform: scale(0.58) rotate(-16deg);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle {
    border-color: rgba(255, 241, 184, 0.86);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 24%, rgba(255, 255, 255, 0.18), transparent 44%),
      rgba(22, 24, 43, 0.96);
    box-shadow:
      0 0 0 3px rgba(255, 241, 184, 0.1),
      0 0 18px rgba(255, 224, 128, 0.2),
      3px 3px 0 rgba(88, 21, 47, 0.48);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle::before {
    background: rgba(255, 241, 184, 0.12);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle:focus-visible {
    outline-color: #fff1b8;
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle:hover,
  :global(html[data-skin="nocturne"]) .nocturne-toggle:focus-visible {
    border-color: #fff6cf;
    transform: translateY(-1px);
    box-shadow:
      0 0 0 4px rgba(255, 241, 184, 0.13),
      0 0 22px rgba(255, 224, 128, 0.27),
      4px 4px 0 rgba(88, 21, 47, 0.52);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle__emoji--angel {
    opacity: 1;
    filter: drop-shadow(0 0 5px rgba(255, 238, 166, 0.38));
    transform: scale(1) rotate(0);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle:hover .nocturne-toggle__emoji--angel,
  :global(html[data-skin="nocturne"]) .nocturne-toggle:focus-visible .nocturne-toggle__emoji--angel {
    transform: translateY(-1px) scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .nocturne-toggle,
    .nocturne-toggle::before,
    .nocturne-toggle__emoji {
      transition: none;
    }
  }
</style>
