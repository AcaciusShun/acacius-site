---
---

<button
  class="nocturne-toggle"
  id="nocturne-toggle"
  type="button"
  aria-label="进入绯红夜曲"
  aria-pressed="false"
  title="Crimson Nocturne"
>
  <svg
    class="nocturne-toggle__icon"
    width="25"
    height="25"
    viewBox="0 0 32 32"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <g class="nocturne-toggle__mark nocturne-toggle__mark--devil" data-nocturne-mark="devil">
      <path
        class="nocturne-toggle__devil-solid"
        fill="currentColor"
        d="M11.8 9.2C7.6 9 4.8 6.3 4.2 2.3c3.7.8 6.4 2.6 8.1 5.6l-.5 1.3Zm8.4 0c4.2-.2 7-2.9 7.6-6.9-3.7.8-6.4 2.6-8.1 5.6l.5 1.3ZM7.7 11.5c3-2.6 13.6-2.6 16.6 0l-1 9.2c-.5 5.1-3.4 7.6-7.3 7.6s-6.8-2.5-7.3-7.6l-1-9.2Z"
      />
      <path
        class="nocturne-toggle__devil-cut"
        fill="#68102f"
        d="m10.3 15 4.5 1-3.8 2.7-.7-3.7Zm11.4 0-4.5 1 3.8 2.7.7-3.7ZM10.8 21c3.2 2.3 7.2 2.3 10.4 0-.9 3.8-2.8 5.4-5.2 5.4s-4.3-1.6-5.2-5.4Z"
      />
      <path
        class="nocturne-toggle__devil-fang"
        fill="#fff7dc"
        d="m12.7 22.2 1.8.7-.9 1.7-.9-2.4Zm6.6 0-1.8.7.9 1.7.9-2.4Z"
      />
      <path
        class="nocturne-toggle__devil-tail"
        fill="none"
        stroke="currentColor"
        stroke-width="1.55"
        d="M22.9 25c3.9 1.5 6-.6 4.6-2.9-.8-1.4-3-.7-2.5.9m2.1-3.2.5 3.3-3.1-1"
      />
    </g>

    <g
      class="nocturne-toggle__mark nocturne-toggle__mark--angel"
      data-nocturne-mark="angel"
      display="none"
    >
      <ellipse
        class="nocturne-toggle__halo"
        cx="16"
        cy="4.4"
        rx="7.1"
        ry="2.2"
        fill="currentColor"
        fill-opacity="0.08"
        stroke="currentColor"
        stroke-width="1.5"
      />
      <path
        class="nocturne-toggle__wing"
        fill="currentColor"
        fill-opacity="0.1"
        stroke="currentColor"
        stroke-width="1.35"
        d="M9.7 14.1c-3-3.4-6.7-2.7-6.6 1 .1 2.8 2.4 4.8 5.8 5-2.1 1.5-2.8 3.4-1.7 5.2 2.6-.5 4.7-2.5 5.5-5.3m9.6-5.9c3-3.4 6.7-2.7 6.6 1-.1 2.8-2.4 4.8-5.8 5 2.1 1.5 2.8 3.4 1.7 5.2-2.6-.5-4.7-2.5-5.5-5.3"
      />
      <path
        class="nocturne-toggle__angel-face"
        fill="#16182b"
        fill-opacity="0.9"
        stroke="currentColor"
        stroke-width="1.45"
        d="M9.2 10.6c2.7-2 10.9-2 13.6 0l-.6 9.2c-.3 4.1-2.8 6.6-6.2 6.6s-5.9-2.5-6.2-6.6l-.6-9.2Z"
      />
      <path
        class="nocturne-toggle__angel-detail"
        fill="none"
        stroke="currentColor"
        stroke-width="1.35"
        d="M11.4 15.9c1.1.9 2.3.9 3.4 0m2.4 0c1.1.9 2.3.9 3.4 0m-7.3 4.4c1.7 1.2 3.7 1.2 5.4 0"
      />
      <path
        class="nocturne-toggle__shine"
        fill="none"
        stroke="currentColor"
        stroke-width="1.35"
        d="M25.4 6.8v3.6m-1.8-1.8h3.6"
      />
    </g>
  </svg>
</button>

<script is:inline>
  (function () {
    var button = document.getElementById("nocturne-toggle");
    if (!button || button.dataset.init) return;
    button.dataset.init = "true";

    var root = document.documentElement;
    var storageKey = "somlar-skin";
    var transitioning = false;
    var devilMark = button.querySelector('[data-nocturne-mark="devil"]');
    var angelMark = button.querySelector('[data-nocturne-mark="angel"]');

    function isNocturne() {
      return root.dataset.skin === "nocturne";
    }

    function syncControls() {
      var active = isNocturne();
      button.setAttribute("aria-pressed", String(active));
      button.setAttribute("aria-label", active ? "退出绯红夜曲" : "进入绯红夜曲");
      button.title = active ? "Return to the standard theme" : "Enter Crimson Nocturne";
      button.dataset.mark = active ? "angel" : "devil";
      if (devilMark) {
        if (active) devilMark.setAttribute("display", "none");
        else devilMark.removeAttribute("display");
      }
      if (angelMark) {
        if (active) angelMark.removeAttribute("display");
        else angelMark.setAttribute("display", "none");
      }

      var standardToggle = document.getElementById("theme-toggle");
      if (standardToggle) standardToggle.hidden = active;
    }

    function applySkin(next) {
      if (next) {
        root.dataset.skin = "nocturne";
      } else {
        delete root.dataset.skin;
      }

      try {
        if (next) localStorage.setItem(storageKey, "nocturne");
        else localStorage.removeItem(storageKey);
      } catch (error) {
        // The visual state still works when storage is unavailable.
      }

      syncControls();
      window.dispatchEvent(new CustomEvent("somlar:skinchange", { detail: { skin: next ? "nocturne" : "standard" } }));
    }

    button.addEventListener("click", function () {
      if (transitioning) return;
      transitioning = true;
      button.disabled = true;

      var next = !isNocturne();
      var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var transitionMode = next ? "nocturne-transition--enter" : "nocturne-transition--exit";
      var rect = button.getBoundingClientRect();
      root.style.setProperty("--theme-x", rect.left + rect.width / 2 + "px");
      root.style.setProperty("--theme-y", rect.top + rect.height / 2 + "px");

      function release() {
        root.classList.remove(
          "nocturne-transition",
          "nocturne-transition--enter",
          "nocturne-transition--exit"
        );
        button.disabled = false;
        transitioning = false;
      }

      if (!reduceMotion && document.startViewTransition) {
        root.classList.add("nocturne-transition", transitionMode);
        var transition = document.startViewTransition(function () {
          applySkin(next);
        });
        transition.finished.then(release, release);
      } else {
        applySkin(next);
        release();
      }
    });

    syncControls();
  })();
</script>

<style>
  .nocturne-toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid rgba(255, 55, 111, 0.86);
    border-radius: 11px 5px 11px 5px;
    color: #fff7dc;
    background:
      linear-gradient(145deg, rgba(255, 255, 255, 0.18), transparent 42%),
      linear-gradient(145deg, #ed2c63, #8e153f);
    box-shadow:
      0 0 0 3px rgba(255, 55, 111, 0.1),
      3px 3px 0 rgba(88, 21, 47, 0.34);
    cursor: pointer;
    isolation: isolate;
    overflow: visible;
    transition:
      border-color var(--duration-fast) var(--ease-smooth),
      background-color var(--duration-fast) var(--ease-smooth),
      transform var(--duration-fast) var(--ease-bounce),
      box-shadow var(--duration-fast) var(--ease-smooth);
  }

  .nocturne-toggle::before {
    content: "";
    position: absolute;
    inset: 4px;
    z-index: -1;
    border-radius: inherit;
    background: rgba(255, 174, 198, 0.22);
    opacity: 0.42;
    transform: scale(0.72) rotate(-8deg);
    transition:
      opacity var(--duration-fast) var(--ease-smooth),
      transform var(--duration-normal) var(--ease-bounce);
  }

  .nocturne-toggle:hover,
  .nocturne-toggle:focus-visible {
    border-color: #ff7ca2;
    transform: translateY(-1px) rotate(-2deg);
    box-shadow:
      0 0 0 4px rgba(255, 55, 111, 0.15),
      4px 4px 0 rgba(88, 21, 47, 0.4);
  }

  .nocturne-toggle:hover::before,
  .nocturne-toggle:focus-visible::before,
  .nocturne-toggle[aria-pressed="true"]::before {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  .nocturne-toggle:focus-visible {
    outline: 2px solid #ff376f;
    outline-offset: 3px;
  }

  .nocturne-toggle:disabled {
    cursor: wait;
  }

  .nocturne-toggle__icon {
    display: block;
    overflow: visible;
    transform-origin: 50% 55%;
    transition:
      transform var(--duration-normal) var(--ease-bounce),
      filter var(--duration-normal) var(--ease-smooth);
  }

  .nocturne-toggle__devil-solid {
    fill: currentColor;
  }

  .nocturne-toggle__devil-cut {
    fill: #68102f;
  }

  .nocturne-toggle__devil-fang {
    fill: #fff7dc;
  }

  .nocturne-toggle__devil-tail,
  .nocturne-toggle__halo,
  .nocturne-toggle__wing,
  .nocturne-toggle__angel-face,
  .nocturne-toggle__angel-detail,
  .nocturne-toggle__shine {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nocturne-toggle__devil-tail {
    fill: none;
    stroke-width: 1.55;
  }

  .nocturne-toggle__halo {
    fill: rgba(255, 241, 184, 0.08);
    stroke-width: 1.5;
  }

  .nocturne-toggle__wing {
    fill: rgba(255, 241, 184, 0.1);
    stroke-width: 1.35;
  }

  .nocturne-toggle__angel-face {
    fill: rgba(22, 24, 43, 0.9);
    stroke-width: 1.45;
  }

  .nocturne-toggle__angel-detail,
  .nocturne-toggle__shine {
    fill: none;
    stroke-width: 1.35;
  }

  .nocturne-toggle__mark--devil {
    filter: drop-shadow(0 1px 1px rgba(41, 5, 22, 0.66));
    transform-origin: 50% 55%;
  }

  .nocturne-toggle__mark--angel {
    filter: drop-shadow(0 0 4px rgba(255, 238, 166, 0.32));
    transform-origin: 50% 52%;
  }

  .nocturne-toggle:hover .nocturne-toggle__icon,
  .nocturne-toggle:focus-visible .nocturne-toggle__icon {
    transform: scale(1.07) rotate(-3deg);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle {
    color: #fff1b8;
    border-color: rgba(255, 241, 184, 0.86);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 24%, rgba(255, 255, 255, 0.18), transparent 44%),
      rgba(22, 24, 43, 0.96);
    box-shadow:
      0 0 0 3px rgba(255, 241, 184, 0.1),
      0 0 18px rgba(255, 224, 128, 0.2),
      3px 3px 0 rgba(88, 21, 47, 0.48);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle::before {
    background: rgba(255, 241, 184, 0.12);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle:focus-visible {
    outline-color: #fff1b8;
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle:hover,
  :global(html[data-skin="nocturne"]) .nocturne-toggle:focus-visible {
    border-color: #fff6cf;
    transform: translateY(-1px);
    box-shadow:
      0 0 0 4px rgba(255, 241, 184, 0.13),
      0 0 22px rgba(255, 224, 128, 0.27),
      4px 4px 0 rgba(88, 21, 47, 0.52);
  }

  :global(html[data-skin="nocturne"]) .nocturne-toggle:hover .nocturne-toggle__icon,
  :global(html[data-skin="nocturne"]) .nocturne-toggle:focus-visible .nocturne-toggle__icon {
    transform: translateY(-1px) scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .nocturne-toggle,
    .nocturne-toggle::before,
    .nocturne-toggle__icon {
      transition: none;
    }
  }
</style>
