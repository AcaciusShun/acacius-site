---

<button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
  <svg class="theme-toggle__icon theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5" />
    <line x1="12" y1="1" x2="12" y2="3" />
    <line x1="12" y1="21" x2="12" y2="23" />
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
    <line x1="1" y1="12" x2="3" y2="12" />
    <line x1="21" y1="12" x2="23" y2="12" />
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
  </svg>
  <svg class="theme-toggle__icon theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.init) return;
    btn.dataset.init = "1";

    var sun = btn.querySelector(".theme-toggle__sun");
    var moon = btn.querySelector(".theme-toggle__moon");
    var dur = 450;
    var easing = "cubic-bezier(0.34, 1.2, 0.64, 1)";

    var arcExit = [
      { transform: "translate(0, 0)", opacity: 1 },
      { transform: "translate(-10px, -8px)", opacity: 1, offset: 0.4 },
      { transform: "translate(-24px, 6px)", opacity: 0 }
    ];

    var arcEnter = [
      { transform: "translate(24px, 6px)", opacity: 0 },
      { transform: "translate(12px, -2px)", opacity: 1, offset: 0.3 },
      { transform: "translate(-2px, -6px)", opacity: 1, offset: 0.65 },
      { transform: "translate(0, 0)", opacity: 1 }
    ];

    function isDark() {
      return document.documentElement.classList.contains("dark");
    }

    function setIcons(animate) {
      var dark = isDark();
      var show = dark ? moon : sun;
      var hide = dark ? sun : moon;

      if (!animate) {
        show.style.transform = "translate(0, 0)";
        show.style.opacity = "1";
        hide.style.transform = "translate(-24px, 6px)";
        hide.style.opacity = "0";
        return;
      }

      hide.style.transform = "";
      hide.style.opacity = "";
      show.style.transform = "";
      show.style.opacity = "";

      var exitAnim = hide.animate(arcExit, { duration: dur, easing: easing, fill: "forwards" });
      var enterAnim = show.animate(arcEnter, { duration: dur, easing: easing, fill: "forwards" });

      exitAnim.onfinish = function () {
        exitAnim.cancel();
        hide.style.transform = "translate(-24px, 6px)";
        hide.style.opacity = "0";
      };

      enterAnim.onfinish = function () {
        enterAnim.cancel();
        show.style.transform = "translate(0, 0)";
        show.style.opacity = "1";
      };
    }

    btn.addEventListener("click", function () {
      document.body.classList.add("theme-transition");
      document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark() ? "dark" : "light");
      setIcons(true);
      setTimeout(function () {
        document.body.classList.remove("theme-transition");
      }, 400);
    });

    setIcons(false);
  })();
</script>

<style>
  .theme-toggle {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-ink-secondary);
    cursor: pointer;
    overflow: hidden;
    transition: color var(--duration-fast) var(--ease-smooth),
                border-color var(--duration-fast) var(--ease-smooth),
                background-color var(--duration-fast) var(--ease-smooth);
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  .theme-toggle__icon {
    position: absolute;
    flex-shrink: 0;
  }
</style>
