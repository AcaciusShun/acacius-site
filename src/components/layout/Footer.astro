---
import { siteConfig } from "@/lib/config";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__left">
      <span class="footer__brand">{siteConfig.title}</span>
      <span class="footer__divider" aria-hidden="true">&middot;</span>
      <span class="footer__copy">&copy; {year}</span>
    </div>
    <div class="footer__right">
      <a class="footer__link" href="/friends">Friends</a>
      <span class="footer__divider" aria-hidden="true">&middot;</span>
      <a class="footer__link" href="/rss.xml">RSS</a>
      <span class="footer__divider" aria-hidden="true">&middot;</span>
      <span>Crafted with intention</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-rule);
    margin-top: auto;
    padding-top: var(--space-16);
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block: var(--space-8);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-tertiary);
  }

  .footer__left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--color-ink-secondary);
  }

  .footer__right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer__divider {
    color: var(--color-rule-strong);
  }

  .footer__link {
    transition: color var(--duration-fast) var(--ease-smooth);
  }

  .footer__link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .footer__inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
      padding-block: var(--space-6);
    }
  }
</style>
