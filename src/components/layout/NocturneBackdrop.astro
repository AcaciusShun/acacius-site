  </svg>
</div>

<style>
  .nocturne-backdrop {
    position: fixed;
    inset: 64px 0 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    overflow: hidden;
    transition: opacity var(--duration-slow) var(--ease-smooth);
  }

  .nocturne-backdrop svg {
    width: 100%;
    height: 100%;
  }

  .nocturne-backdrop__vines,
  .nocturne-backdrop__thorns {
    fill: none;
    stroke: rgba(255, 55, 111, 0.18);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .nocturne-backdrop__thorns {
    stroke: rgba(160, 62, 117, 0.22);
    stroke-width: 1.5;
  }

  .nocturne-backdrop__embers {
    fill: rgba(255, 55, 111, 0.12);
    stroke: rgba(255, 91, 139, 0.22);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  :global(html[data-skin="nocturne"]) .nocturne-backdrop {
    opacity: 1;
  }

  :global(html[data-skin="nocturne"]) .nocturne-backdrop__vines,
  :global(html[data-skin="nocturne"]) .nocturne-backdrop__thorns {
    stroke-dasharray: 1650;
    stroke-dashoffset: 1650;
    animation: nocturne-vine-spread 1.15s var(--ease-smooth) 120ms forwards;
  }

  :global(html[data-skin="nocturne"]) .nocturne-backdrop__thorns {
    animation-delay: 300ms;
  }

  @keyframes nocturne-vine-spread {
    to { stroke-dashoffset: 0; }
  }

  @media (max-width: 640px) {
    .nocturne-backdrop {
      opacity: 0 !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nocturne-backdrop,
    .nocturne-backdrop__vines,
    .nocturne-backdrop__thorns {
      transition: none;
      animation: none !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>
