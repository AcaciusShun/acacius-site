# Twikoo comments backend — exposed to the client (required by the widget).
PUBLIC_TWIKOO_ENV_ID=

# NeoDB — Library (书影音) sync. Build-time only, never shipped to the client.
# Read-scope personal access token, generated at https://<instance>/developer
NEODB_TOKEN=
# NeoDB instance base URL (defaults to https://neodb.social if unset).
NEODB_INSTANCE=https://neodb.social
